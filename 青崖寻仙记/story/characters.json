[
  {
    "id": "xuan",
    "name": "许安",
    "aliases": [],
    "eraId": "main",
    "group": "主角",
    "crossEra": false,
    "debutChapter": 1,
    "color": "#c8553d",
    "summary": "十六岁的孤儿，南边破庙长大，讨饭北上寻仙。落霞镇一天里被老道云鹤子收为徒弟；拜师第七夜师父没下手，死在静室门外，他接下青崖观和三十块灵石的债，收了小芷、素弦、狗蛋、阿蛮四个人，撑到收债日还清。",
    "fields": [
      {
        "key": "身份",
        "value": "孤儿；第二卷青崖观观主"
      },
      {
        "key": "年龄",
        "value": "16"
      },
      {
        "key": "修为",
        "value": "凡人，掌心发烫（第1天）；夜里引气入体（第9章）；炼气一层（第15章）；收债日前后炼气三层"
      },
      {
        "key": "灵根",
        "value": "三灵根"
      },
      {
        "key": "随身",
        "value": "破庙老乞丐留下的旧储物袋，里头一根打狗棒、一张平安符；三十两（第1章被摸走，第4章摸回）"
      },
      {
        "key": "性格",
        "value": "手脚快、眼尖、肯吃苦，不轻信人；别人对他好一分他记十分。话少，说的多是实在话，偶尔冒一句破庙里学来的俏皮话。会犯错，会怕。"
      },
      {
        "key": "说话方式",
        "value": "短、实在，不文绉绉；对长辈客气，对同龄人随口。"
      }
    ],
    "progressions": [
      {
        "chapter": 1,
        "key": "处境",
        "value": "进镇第一天，钱袋被小顺子摸走，身无分文"
      },
      {
        "chapter": 4,
        "key": "处境",
        "value": "钱袋摸回来了；揭了山魈的榜"
      },
      {
        "chapter": 6,
        "key": "银两",
        "value": "卖灵芝得一百两，身上一百多两"
      },
      {
        "chapter": 9,
        "key": "修为",
        "value": "引气入体（夜里在客栈通铺上）"
      },
      {
        "chapter": 9,
        "key": "伤",
        "value": "背撞在竹子上，左胳膊抬不起来，兽骨盾裂了一道缝"
      },
      {
        "chapter": 10,
        "key": "处境",
        "value": "跟云鹤子上山拜师"
      },
      {
        "chapter": 11,
        "key": "处境",
        "value": "拜师，住东厢靠山门那间；师父不让下山"
      },
      {
        "chapter": 12,
        "key": "灵根",
        "value": "木水土三灵根，练《厚土诀》"
      },
      {
        "chapter": 15,
        "key": "修为",
        "value": "炼气一层"
      },
      {
        "chapter": 16,
        "key": "神识",
        "value": "静室那一夜后脑子格外清明，听得远、分得清"
      },
      {
        "chapter": 17,
        "key": "随身",
        "value": "平安符压进了师父的坟里；储物袋里打狗棒、裂了缝的兽骨盾、六颗自己炼的回春丹（在小芷的葫芦里）"
      },
      {
        "chapter": 17,
        "key": "身份",
        "value": "青崖观观主，穿师父年轻时的青袍、木道冠"
      },
      {
        "chapter": 18,
        "key": "欠账",
        "value": "三十块灵石，九十天（故事第 99 天过完到期）；身上一百四十两出头"
      },
      {
        "chapter": 20,
        "key": "灵石",
        "value": "一块（压在借据上）"
      },
      {
        "chapter": 20,
        "key": "本事",
        "value": "能把丹田的气引到打狗棒上；神识铺三四丈"
      },
      {
        "chapter": 26,
        "key": "随身",
        "value": "兽骨盾在听雨楼被打散；收着镇魂钟、玉竹笛、回春散"
      },
      {
        "chapter": 27,
        "key": "神识",
        "value": "能铺五六丈，看得见骰盅里的点数"
      },
      {
        "chapter": 28,
        "key": "银两",
        "value": "冯捕头还了二十两本钱加一百两县里赏银"
      }
    ]
  },
  {
    "id": "yunhezi",
    "name": "云鹤子",
    "aliases": [
      "老道",
      "师父"
    ],
    "eraId": "main",
    "group": "师父",
    "crossEra": false,
    "debutChapter": 2,
    "color": "#5d6b74",
    "summary": "青崖观老观主，干瘦，咳嗽，八岁上山，炼气六十年没筑基。押地契向万宝楼借三十块灵石布聚灵阵冲筑基未成，寿元将尽，收许安本为夺舍；第七夜在静室门外坐到天亮没进去，死在门口。第一卷要到山魈那一仗后才报名号，此前叫“老道”。",
    "fields": [
      {
        "key": "身份",
        "value": "青崖观观主"
      },
      {
        "key": "说话方式",
        "value": "慢，爱讲山上的旧事，讲着讲着自己先笑；一提到账、提到修为就摆摆手不想多说。"
      },
      {
        "key": "想要",
        "value": "青崖观别断在他手里"
      }
    ],
    "progressions": [
      {
        "chapter": 9,
        "key": "称呼",
        "value": "报了名号云鹤子，住在山上"
      },
      {
        "chapter": 16,
        "key": "状态",
        "value": "死在静室门外，留下遗书"
      },
      {
        "chapter": 17,
        "key": "葬处",
        "value": "后山老松下，师兄们的六个土包旁边，没有碑"
      }
    ]
  },
