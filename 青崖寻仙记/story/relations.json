[
  {
    "id": "r-xu-yun",
    "from": "xuan",
    "to": "yunhezi",
    "label": "路人：扶一个咳嗽的老道去赊药",
    "progressions": [
      {
        "chapter": 9,
        "label": "竹林里他捏着没用上的符来了：好身手"
      },
      {
        "chapter": 10,
        "label": "子时收徒：缺一个传人，明早跟老道上山"
      },
      {
        "chapter": 11,
        "label": "师徒：问生辰、问家里有没有人惦记；照灵盘亮三道，“总算等来一个按得亮的”"
      },
      {
        "chapter": 14,
        "label": "师父说去州府看病，他留下守观一个月"
      },
      {
        "chapter": 19,
        "label": "师父回山：收拾得不错；灵石推回来；他冲开一层，师父说“好，好！”"
      },
      {
        "chapter": 20,
        "label": "起疑后当面问过红光和那本书，选了信他"
      },
      {
        "chapter": 22,
        "label": "魂到了他眉心前，又退走了；只留一张短信：青崖观交给你了"
      },
      {
        "chapter": 24,
        "label": "观交给我了，不卖；心里的疙瘩没解开"
      }
    ]
  },
